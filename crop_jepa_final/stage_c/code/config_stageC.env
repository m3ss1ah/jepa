# =====================================================================================
#  config_stageC.env - cluster settings for Crop-JEPA Stage C.
#  The EXPERIMENT (arms, seeds, steps, splits per phase) is NOT set here: it is fixed in PHASE_PLAN inside
#  crop_jepa_stageC.py and frozen in the Phase-0 pre-registration. stageC_common.sh exports exactly that plan,
#  and every phase refuses to run if its configuration differs from the registered plan.
# =====================================================================================

# ---- Stage B inputs (read only; nothing in this folder is ever written) ----
export STAGEB_DIR="$HOME/crop_jepa_cluster"
export CJ_CACHE_DIR="$STAGEB_DIR/outputs_stageB/cache"              # images_192.npy + images_192.csv
export STAGEB_SPLITS="$STAGEB_DIR/outputs_stageB/splits.csv"        # Split A
export STAGEB_SEED_LEVEL="$STAGEB_DIR/outputs_stageB/stats/seed_level_primary.csv"   # for the bridge pooling

# ---- Stage C outputs (relative to this folder) ----
export OUT_ROOT="./outputs_stageC"

# ---- GPUs / workers ----
export NUM_GPUS=1               # one RTX 6000 Ada (starts sooner than two); 2 also works, the job adapts to what it gets
export WORKERS_PER_GPU=3        # ViT-Tiny leaves most of a 48 GB GPU idle; 3 workers per GPU was ~2.1x faster in Stage B
export CPUS_PER_TASK=32         # = Stage B job 2070 (1 GPU, 3 workers); 8 BLAS threads per worker
export MEM_GB=64                # = Stage B job 2070 (same node, same cache, same 3 workers); est. peak ~15-20 GB

# ---- job ----
export WALL_TIME="3-00:00:00"   # 72 h: the whole 1-GPU study (est. 45-52 h) in one allocation; must be <= the partition
                                # limit (check: sinfo -p general -h -o "%l"). If a job runs out, it re-submits itself.
export MAX_ATTEMPTS=6
export PARTITION="general"

# ---- optional reference baseline ----
export ENABLE_DINOV2=1          # frozen DINOv2 ViT-S/14 reference; downloaded by the prep job, skipped if unreachable

# ---- environment (same versions as Stage B) ----
export TORCH_SPEC="torch==2.8.0 torchvision==0.23.0"
export TORCH_FALLBACK_INDEX="https://download.pytorch.org/whl/cu126"
export OTHER_PKGS="numpy pandas scikit-learn scipy matplotlib pillow psutil"

# ---- safety ----
export CJ_ALLOW_CODE_CHANGE=0   # 1 only for a deliberate bug fix after registration (logged in outputs_stageC/DEVIATIONS.md)
