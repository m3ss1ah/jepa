# =====================================================================================
#  config.env  -  every setting lives here. The defaults reproduce the notebook's
#  pre-registered Stage-B design exactly. You normally change NOTHING in this file.
# =====================================================================================

# ---- experiment (pre-registered; changing these after results exist = a logged amendment) ----
export CJ_SEEDS="0,1,2,3,4,5"
export CJ_ARMS="ijepa,veg_pos,veg_neg,pos_matched"
export CJ_BASELINES="random_init,supervised"      # add ",dinov2" only if the cluster can reach github.com (see guide)
export CJ_TARGET_STEPS=9000
export CJ_PILOT_STEPS=26000

# ---- optional Tier-2 extras (all exploratory, all OFF by default; each adds GPU hours) ----
export CJ_ENABLE_ATTN=0          # +3 runs
export CJ_ENABLE_TAU_SWEEP=0     # +6 runs
export CJ_ENABLE_SIZE_AXIS=0     # +12 shorter runs
export CJ_ENABLE_LEJEPA=0        # +12 runs, ~3x cost each, implementation is flagged [UNVERIFIED] in the notebook

# ---- Gate 0 behaviour ----
# 0 = if the pilot FAILS Gate 0, stop and keep the GPU free (recommended, this is what the notebook intends)
# 1 = run the full grid anyway
export CJ_IGNORE_GATE0=0

# ---- folders (relative to this project folder) ----
export CJ_DATA_ROOT="./lucas_data"           # raw LUCASVision photos (input, downloaded automatically)
export CJ_OUTPUT_DIR="./outputs_stageB"      # EVERYTHING produced lives here (runs, stats, figures, tables, logs, zip)

# ---- cluster speed-ups ----
# ViT-Tiny does not fill an RTX A6000, so the grid is split over this many worker processes sharing the one GPU.
# Results are identical to a single process (same seeds, same data order). 1 = off.
export NUM_SHARDS=3

# ---- cluster / job ----
export WALL_HOURS=36            # must match "#SBATCH --time" in gpu_job.sbatch (1-12:00:00 = 36 h)
export MAX_ATTEMPTS=5           # automatic re-submits if a job runs out of wall time
# Packages. PyPI wheels of torch 2.8.0 are built for CUDA 12.8 and run on any NVIDIA driver >= 525.
export TORCH_SPEC="torch==2.8.0 torchvision==0.23.0"
export TORCH_FALLBACK_INDEX="https://download.pytorch.org/whl/cu126"   # only tried if the PyPI wheel cannot see the GPU
export OTHER_PKGS="numpy pandas scikit-learn scipy matplotlib pillow psutil"
